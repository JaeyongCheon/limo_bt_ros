<?xml version="1.0"?>
<!--
  구조 로봇 BT - 팀원 3 구현 노드 (11개 모두 사용)
  나선형 탐색, 경로 생성, 시각화, 동반 안내
-->

<root main_tree_to_execute="MainTree">
  
  <BehaviorTree ID="MainTree">
    <Sequence name="RescueMission">
      
      <!-- Odometry 업데이트 (매 틱마다) -->
      <Action ID="UpdateOdometry" name="UpdateOdom"/>
      
      <!-- Phase 0: 목표 좌표 입력 (터미널) -->
      <Sequence name="GetGoalInput">
        <!-- 터미널에서 목표 좌표 입력 받기 -->
        <Action ID="GetUserInput" name="InputGoal" timeout="60" relative="false"/>
      </Sequence>
      
      <!-- Phase 1: 목표까지 자율주행 -->
      <Sequence name="NavigateToGoal">
        <!-- 입력받은 목표까지 이동 (맵 없이 오도메트리만 사용) -->
        <Action ID="NavigateToGoal" name="Navigate" speed="0.3" angular_speed="0.5" goal_threshold="0.2"/>
      </Sequence>
      
      <!-- Phase 2: 초기화 및 조난자 탐색 -->
      <Sequence name="SearchPhase">
        <!-- 1. GridMap 데이터 확인 -->
        <Condition ID="HasGridMapData" name="CheckGridMap"/>
        
        <!-- 2. 나선형 경로점 생성 (조난자 탐색용) -->
        <Action ID="GenerateSpiralWaypoints" name="CreateSpiral"/>
        
        <!-- 3. 조난자 탐색 루프 -->
        <ReactiveFallback name="SearchLoop">
          <!-- 조난자 발견 확인 -->
          <Condition ID="IsVictimDetected" name="CheckVictim"/>
          
          <!-- 아직 못 찾았으면 계속 탐색 -->
          <Sequence name="ContinueSearch">
            <Action ID="GetNextWaypoint" name="GetWaypoint"/>
            <Action ID="MoveToTarget" name="MoveToWaypoint"/>
            <Action ID="WaitForDuration" name="SearchDelay"/>
          </Sequence>
        </ReactiveFallback>
      </Sequence>
      
      <!-- Phase 2: 구조 경로 생성 및 시각화 -->
      <Sequence name="PlanningPhase">
        <!-- 4. 구조 경로 생성 (안전/균형/최단 3가지) -->
        <Action ID="GenerateRescuePaths" name="CreatePaths"/>
        
        <!-- 5. 경로 시각화 (RViz에 표시) -->
        <Action ID="VisualizeResults" name="ShowPaths"/>
        
        <!-- 6. 미션 성공 알림 -->
        <Action ID="PublishMissionSuccess" name="AnnounceSuccess"/>
      </Sequence>
      
      <!-- Phase 3: 귀환 및 구조대 대기 -->
      <Sequence name="ReturnPhase">
        <!-- 7. 초기 위치로 귀환 -->
        <Action ID="ReturnToBase" name="SetHomeTarget"/>
        <Action ID="MoveToTarget" name="GoHome"/>
        
        <!-- 8. 구조대 준비 대기 (30초 타임아웃) -->
        <Action ID="WaitForRescueTeam" name="WaitTeam"/>
      </Sequence>
      
      <!-- Phase 4: 구조대 동반 안내 -->
      <Sequence name="EscortPhase">
        <!-- 9. 위험 구간 경고 -->
        <Action ID="WarnDangerZone" name="WarnDanger"/>
        
        <!-- 10. 구조대 추종 확인 -->
        <Action ID="CheckTeamFollowing" name="CheckTeam"/>
        
        <!-- 11. 구조대 동반 안내 -->
        <Action ID="EscortToVictim" name="EscortMode"/>
        
        <!-- 12. 조난자 위치 도착 알림 -->
        <Action ID="AnnounceArrival" name="Arrival"/>
      </Sequence>
      
    </Sequence>
  </BehaviorTree>
  
  <!-- ========================================= -->
  <!-- 노드 정의 (Groot 시각화용)                -->
  <!-- ========================================= -->
  <TreeNodesModel>
    
    <!-- Condition Nodes -->
    <Condition ID="HasGridMapData">
      <output_port name="grid_map">GridMap 데이터</output_port>
    </Condition>
    
    <Condition ID="IsVictimDetected">
      <output_port name="victim_location">조난자 위치</output_port>
    </Condition>
    
    <!-- Action Nodes -->
    <Action ID="GenerateSpiralWaypoints">
      <input_port name="center">중심 좌표</input_port>
      <input_port name="max_radius" default="5.0">최대 반경 (m)</input_port>
      <output_port name="waypoints">생성된 경로점</output_port>
    </Action>
    
    <Action ID="GetNextWaypoint">
      <input_port name="waypoints">경로점 배열</input_port>
      <output_port name="current_waypoint">현재 경로점</output_port>
    </Action>
    
    <Action ID="GenerateRescuePaths">
      <input_port name="start_pose">시작 위치</input_port>
      <input_port name="victim_pose">조난자 위치</input_port>
      <input_port name="grid_map">지형 맵</input_port>
      <output_port name="rescue_paths">3가지 경로</output_port>
    </Action>
    
    <Action ID="VisualizeResults">
      <input_port name="rescue_paths">경로 데이터</input_port>
      <input_port name="victim_location">조난자 위치</input_port>
    </Action>
    
    <Action ID="PublishMissionSuccess">
      <input_port name="victim_location">조난자 위치</input_port>
    </Action>
    
    <Action ID="ReturnToBase">
      <input_port name="base_position" default="0.0,0.0">기지 위치</input_port>
    </Action>
    
    <Action ID="WaitForRescueTeam">
      <input_port name="timeout" default="30.0">타임아웃 (초)</input_port>
    </Action>
    
    <Action ID="WarnDangerZone">
      <input_port name="escort_info">동반 안내 정보</input_port>
    </Action>
    
    <Action ID="CheckTeamFollowing"/>
    
    <Action ID="EscortToVictim">
      <input_port name="rescue_paths">구조 경로</input_port>
      <input_port name="grid_map">지형 맵</input_port>
      <input_port name="victim_location">조난자 위치</input_port>
    </Action>
    
    <Action ID="AnnounceArrival">
      <input_port name="victim_location">조난자 위치</input_port>
    </Action>
    
    <Action ID="MoveToTarget">
      <input_port name="target_position">목표 위치</input_port>
    </Action>
    
    <Action ID="WaitForDuration">
      <input_port name="wait_duration" default="1.0">대기 시간 (초)</input_port>
    </Action>
    
    <Action ID="UpdateOdometry">
      <output_port name="current_position">현재 위치</output_port>
      <output_port name="start_position">시작 위치</output_port>
    </Action>
    
  </TreeNodesModel>
  
</root>

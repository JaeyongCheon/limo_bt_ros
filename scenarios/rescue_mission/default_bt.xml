<?xml version="1.0"?>
<!--
  기본 액션 노드 테스트 BT
  basic_action_nodes.py 노드들만 사용
-->

<root main_tree_to_execute="MainTree">
  
  <BehaviorTree ID="MainTree">
    <Sequence>
      
      <!-- 1. 시스템 시작 로그 -->
      <LogMessage message="🚀 구조 로봇 시스템 시작" level="INFO"/>
      
      <!-- 2. 목표 좌표 입력 -->
      <Sequence>
        <WaitForMissionCommand/>
        <ParseTargetCommand/>
        <LogMessage message="✅ 목표 좌표 설정 완료" level="INFO"/>
      </Sequence>
      
      <!-- 3. 목표 지점으로 이동 (점진적 재시도 전략) -->
      <Fallback>
        <!-- 성공 시나리오 -->
        <Sequence>
          <LogMessage message="🚗 목표 지점으로 이동 시작 (우회 경로 허용)" level="INFO"/>
          <!-- 3회 재시도: 직접 → 우회 → 멀리 우회 -->
          <Repeat num_cycles="3">
            <Fallback>
              <NavigateToTarget/>
              <Sequence>
                <LogMessage message="⚠️ 경로 실패 - 더 먼 우회로 재시도" level="WARN"/>
                <Wait duration="2.0"/>
              </Sequence>
            </Fallback>
          </Repeat>
          <LogMessage message="✅ 주행 완료!" level="INFO"/>
        </Sequence>
        
        <!-- 실패 시나리오: 초기 위치로 귀환 -->
        <Sequence>
          <LogMessage message="❌ 목표 도달 실패 - 초기 위치로 귀환" level="ERROR"/>
          <ReturnToBase/>
          <Repeat num_cycles="3">
            <Fallback>
              <NavigateToTarget/>
              <Sequence>
                <LogMessage message="⚠️ 귀환 경로 실패 - 재시도" level="WARN"/>
                <Wait duration="2.0"/>
              </Sequence>
            </Fallback>
          </Repeat>
          <LogMessage message="🏠 초기 위치 복귀 완료" level="INFO"/>
        </Sequence>
      </Fallback>
      
      <!-- 4. 대기 -->
      <Sequence>
        <LogMessage message="⏳ 3초 대기" level="INFO"/>
        <Wait duration="3.0"/>
      </Sequence>
    
      
      <!-- 5. 미션 완료 -->
      <LogMessage message="🎉 기본 미션 완료!" level="INFO"/>
      
    </Sequence>
  </BehaviorTree>
  
</root>

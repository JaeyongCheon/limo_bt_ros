<?xml version="1.0"?>
<!--
  기본 액션 노드 테스트 BT
  basic_action_nodes.py 노드들만 사용
-->

<root main_tree_to_execute="MainTree">
  
  <BehaviorTree ID="MainTree">
    <Sequence>
      
      <!-- 1. 시스템 시작 로그 -->
      <LogMessage message="🚀 구조 로봇 시스템 시작" level="INFO"/>
      
      <!-- 2. 목표 좌표 입력 -->
      <Sequence>
        <WaitForMissionCommand/>
        <ParseTargetCommand/>
        <LogMessage message="✅ 목표 좌표 설정 완료" level="INFO"/>
      </Sequence>
      
      <!-- 3. 목표 지점으로 이동 -->
      <Sequence>
        <LogMessage message="🚗 목표 지점으로 이동 시작" level="INFO"/>
        <NavigateToTarget/>
        <LogMessage message="✅ 목표 지점 도착" level="INFO"/>
      </Sequence>
      
      <!-- 4. 대기 -->
      <Sequence>
        <LogMessage message="⏳ 3초 대기" level="INFO"/>
        <Wait duration="3.0"/>
      </Sequence>
      
      <!-- 5. 회전 테스트 -->
      <Sequence>
        <LogMessage message="🔄 90도 회전 테스트" level="INFO"/>
        <RotateToAngle target_angle="1.57"/>
        <LogMessage message="✅ 회전 완료" level="INFO"/>
      </Sequence>
      
      <!-- 6. 미션 완료 -->
      <LogMessage message="🎉 기본 미션 완료!" level="INFO"/>
      
    </Sequence>
  </BehaviorTree>
  
</root>
